root = true

[*.cs]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error

csharp_style_expression_bodied_methods = false:error
csharp_style_expression_bodied_constructors = false:error
csharp_style_expression_bodied_operators = false:error
csharp_style_expression_bodied_local_functions = false:error
dotnet_diagnostic.IDE0021.severity = error
dotnet_diagnostic.IDE0022.severity = error
dotnet_diagnostic.IDE0023.severity = error
dotnet_diagnostic.IDE0024.severity = error
dotnet_diagnostic.IDE0061.severity = error

csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent

dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.campo_privado.capitalization = camel_case
dotnet_naming_style.campo_privado.required_prefix = _

dotnet_naming_symbols.membros_visiveis.applicable_kinds = class,struct,interface,enum,property,method,event,delegate,namespace
dotnet_naming_symbols.membros_visiveis.applicable_accessibilities = public,internal,protected,protected_internal
dotnet_naming_rule.visivel_em_pascal.symbols = membros_visiveis
dotnet_naming_rule.visivel_em_pascal.style = pascal
dotnet_naming_rule.visivel_em_pascal.severity = error

dotnet_naming_symbols.campos_de_instancia.applicable_kinds = field
dotnet_naming_symbols.campos_de_instancia.applicable_accessibilities = private
dotnet_naming_symbols.campos_de_instancia.required_modifiers = readonly
dotnet_naming_rule.campo_com_underscore.symbols = campos_de_instancia
dotnet_naming_rule.campo_com_underscore.style = campo_privado
dotnet_naming_rule.campo_com_underscore.severity = error
